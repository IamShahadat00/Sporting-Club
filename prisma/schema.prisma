datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  EDITOR
  VIEWER
}

enum SeasonStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  hashedPassword String?
  role           Role      @default(VIEWER)
  isApproved     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  matchesCreated Match[]   @relation("MatchCreatedBy")
}

model Season {
  id             String         @id @default(cuid())
  name           String
  status         SeasonStatus   @default(UPCOMING)
  startDate      DateTime?
  endDate        DateTime?
  bannerImageUrl String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  matches        Match[]
  standings      Standing[]
  registrations  Registration[]
  bracket        Bracket?
}

model Team {
  id            String     @id @default(cuid())
  name          String
  logoUrl       String?
  district      String?
  founded       Int?
  titlesWon     Int?       @default(0)
  ownerName     String?
  ownerPhoto    String?
  ownerBio      String?
  mentorName    String?
  mentorPhoto   String?
  mentorBio     String?
  description   String?
  sponsorName   String?
  sponsorLogo   String?
  captainId     String?
  viceCaptainId String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  players       Player[]
  homeMatches   Match[]    @relation("HomeTeam")
  awayMatches   Match[]    @relation("AwayTeam")
  standings     Standing[]
}

model Player {
  id            String         @id @default(cuid())
  name          String
  position      String?
  jerseyNumber  Int?
  district      String?
  photoUrl      String?
  strongFoot    String?
  bio           String?
  goals         Int            @default(0)
  isInjured     Boolean        @default(false)
  returnDate    DateTime?
  teamId        String?
  team          Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  mvpAwards     MvpAward[]
  registrations Registration[]
  hallOfFame    HallOfFame[]
}

model Match {
  id              String         @id @default(cuid())
  matchNumber     Int
  seasonId        String
  season          Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  homeTeamId      String
  homeTeam        Team           @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId      String
  awayTeam        Team           @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeScore       Int            @default(0)
  awayScore       Int            @default(0)
  status          String         @default("SCHEDULED")
  scheduledStart  DateTime
  actualStart     DateTime?
  venue           String?
  broadcastUrl    String?
  highlightsUrl   String?
  highlightsTitle String?
  report          String?
  events          Json?          @default("[]")
  isPenalty       Boolean        @default(false)
  homePens        Int            @default(0)
  awayPens        Int            @default(0)
  createdById     String
  createdBy       User           @relation("MatchCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  mvpAward        MvpAward?
  bracketMatches  BracketMatch[]
}

model MvpAward {
  id        String   @id @default(cuid())
  matchId   String   @unique
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  citation  String?
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Standing {
  id           String   @id @default(cuid())
  seasonId     String
  season       Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  played       Int      @default(0)
  won          Int      @default(0)
  drawn        Int      @default(0)
  lost         Int      @default(0)
  points       Int      @default(0)
  goalDiff     Int      @default(0)
  goalsFor     Int      @default(0)
  goalsAgainst Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([seasonId, teamId])
}

model Registration {
  id        String             @id @default(cuid())
  playerId  String
  player    Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  seasonId  String
  season    Season             @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  status    RegistrationStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model Bracket {
  id        String         @id @default(cuid())
  seasonId  String         @unique
  season    Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  rounds    BracketMatch[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model BracketMatch {
  id        String   @id @default(cuid())
  bracketId String
  bracket   Bracket  @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  matchId   String?
  match     Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)
  round     Int
  slotIndex Int
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sponsor {
  id          String   @id @default(cuid())
  name        String
  tier        String
  logoUrl     String?
  websiteUrl  String?
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Banner {
  id        String   @id @default(cuid())
  imageUrl  String
  linkUrl   String?
  startAt   DateTime
  endAt     DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Director {
  id          String   @id @default(cuid())
  name        String
  designation String
  profession  String?
  bio         String?
  photoUrl    String?
  order       Int?     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  type      String   @default("NEWS")
  content   String
  imageUrl  String?
  linkUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HallOfFame {
  id          String   @id @default(cuid())
  name        String
  title       String
  year        String
  description String?
  imageUrl    String?
  playerId    String?
  player      Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}